{
  "manifest_version": 3,
  "name": "codex登录验证器",
  "version": "1.1.0",
  "description": "Exports ChatGPT session auth.json for Codex and ccswitch.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "alarms"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "codex登录验证器",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://codex.passionapi.com/*"
  ],
  "update_url": "https://codex.passionapi.com/extension/updates.xml"
}
